{
  "name": "iccworship",
  "productName": "ICCWorship",
  "version": "1.0.0",
  "description": "Free, open-source, bilingual (English/Español) church presentation and service planning app for Windows.",
  "main": "./out/main/index.js",
  "author": "ICCWorship contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bibles": "node scripts/build-bibles.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:dir": "electron-vite build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^27.2.7",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
