{
  "name": "iccworship",
  "productName": "ICCWorship",
  "version": "1.0.0",
  "description": "Free, open-source, bilingual (English/Español) church presentation and service planning app for Windows.",
  "main": "./out/main/index.js",
  "author": "ICCWorship contributors",
  "license": "MIT",
  "homepage": "https://github.com/nunez1822/ICCWorship#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nunez1822/ICCWorship.git"
  },
  "bugs": {
    "url": "https://github.com/nunez1822/ICCWorship/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "vp check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "node scripts/test.mjs run",
    "bibles": "node scripts/build-bibles.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e:launch": "node scripts/e2e-launch.mjs",
    "build:win": "electron-vite build && node scripts/licenses.mjs && electron-builder --win --publish never --config electron-builder.yml",
    "build:dir": "electron-vite build && node scripts/licenses.mjs && electron-builder --win --dir --publish never --config electron-builder.yml",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "licenses": "node scripts/licenses.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "packaged-check": "node scripts/packaged-check.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^27.2.7",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zustand": "^5.1.0"
  }
}
